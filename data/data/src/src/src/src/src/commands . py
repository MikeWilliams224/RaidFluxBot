from telegram import Update
from telegram.ext import ContextTypes
from .storage import load_projects, save_projects, load_templates, save_templates
from .config import ADMIN_IDS, DEFAULT_PROJECT, ENABLE_AUTOWELCOME
from .utils import now_ts, ts_to_iso

def is_admin(user_id: int):
    return user_id in ADMIN_IDS

async def cmd_start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("👋 Welcome to RaidFlux. Use /help to see commands.")

async def cmd_help(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = (
        "/info <project> — show project info\n"
        "/templates <project> — show templates\n"
        "/raid <project> — start raid flow\n\n"
        "Admin commands:\n"
